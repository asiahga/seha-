    function checkData() {
      const idNumberInput = document.getElementById('idNumber');
      const leaveCodeInput = document.getElementById('leaveCode');
      const idNumber = idNumberInput.value.trim();
      const leaveCode = leaveCodeInput.value.trim();
      const emptyFieldsError = document.getElementById('emptyFieldsError');
      const searchBtn = document.getElementById('searchBtn');
      const searchBtnText = document.getElementById('searchBtnText'); // Keep reference to text span
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorTab = document.getElementById("errorTab");
      const resultBox = document.getElementById("resultBox");
      const leaveCodeContainer = document.getElementById('leaveCodeContainer');
      const idNumberContainer = document.getElementById('idNumberContainer');

      // Check for empty fields first
      if (!idNumber || !leaveCode) {
        emptyFieldsError.style.display = 'block';
        leaveCodeContainer.style.marginTop = '5px'; 
        idNumberContainer.style.marginTop = '5px'; 
        errorTab.style.display = 'none';
        resultBox.style.display = 'none';
        return;
      } else {
        emptyFieldsError.style.display = 'none';
        leaveCodeContainer.style.marginTop = ''; 
        idNumberContainer.style.marginTop = ''; 
      }

      // --- Start Loading State --- 
      // searchBtnText.style.display = 'none'; // **REMOVED**: Keep text visible
      loadingSpinner.style.display = 'inline-block'; // Show spinner next to text
      searchBtn.classList.add('loading'); // Add class for darker background
      searchBtn.disabled = true;
      errorTab.style.display = "none"; 
      resultBox.style.display = "none";

      // --- Simulate 2-second delay (Changed from 3000 to 2000) --- 
      setTimeout(() => {
        const storedData = JSON.parse(localStorage.getItem("leaveData")) || [];
        const result = storedData.find(d => d.leaveCode === leaveCode && d.idNumber === idNumber);

        // --- End Loading State --- 
        loadingSpinner.style.display = 'none'; // Hide spinner
        searchBtn.classList.remove('loading'); // Remove class to restore original background
        searchBtn.disabled = false;
        // searchBtnText.style.display = 'inline'; // **REMOVED**: Text was never hidden

        // Process the result
        if (result) {
          resultBox.innerHTML = `
            <div class="info-label bold">الاسم</div><div class="info-data normal">${result.name.trim()}</div>
            <div class="info-label bold">تاريخ إصدار تقرير الاجازة</div><div class="info-data normal">${result.date}</div>
            <div class="info-label bold">تبدأ من</div><div class="info-data normal">${result.from}</div>
            <div class="info-label bold">وحتى</div><div class="info-data normal">${result.to}</div>
            <div class="info-label bold">المدة بالأيام</div><div class="info-data normal">${result.days}</div>
            <div class="info-label bold">اسم الطبيب</div><div class="info-data normal">${result.doctor.trim()}</div>
            <div class="info-label bold">المسمى الوظيفي</div><div class="info-data normal">${result.title.trim()}</div>
          `;
          resultBox.style.display = "block";
          errorTab.style.display = "none";
          document.getElementById('searchBtn').style.display = 'none';
          document.getElementById('backBtn').style.display = 'none';
          document.getElementById('newSearchBtn').style.display = 'block';
          document.getElementById('backListBtn').style.display = 'block';
        } else {
          resultBox.style.display = "none";
          errorTab.style.display = "block";
          document.getElementById('searchBtn').style.display = 'block'; 
          document.getElementById('backBtn').style.display = 'block';
          document.getElementById('newSearchBtn').style.display = 'none';
          document.getElementById('backListBtn').style.display = 'none';
        }
      }, 2000); // 2000 milliseconds = 2 seconds
    }

    function hideEmptyError() {
      const emptyFieldsError = document.getElementById('emptyFieldsError');
      const leaveCodeContainer = document.getElementById('leaveCodeContainer');
      const idNumberContainer = document.getElementById('idNumberContainer');
      if (emptyFieldsError.style.display === 'block') {
          emptyFieldsError.style.display = 'none';
          leaveCodeContainer.style.marginTop = ''; 
          idNumberContainer.style.marginTop = ''; 
      }
    }

    function resetForm() {
      const searchBtn = document.getElementById('searchBtn'); // Get button reference
      document.getElementById('idNumber').value = '';
      document.getElementById('leaveCode').value = '';
      document.getElementById('errorTab').style.display = 'none';
      document.getElementById('emptyFieldsError').style.display = 'none';
      document.getElementById('resultBox').style.display = 'none';
      document.getElementById('searchBtn').style.display = 'block';
      document.getElementById('backBtn').style.display = 'block';
      document.getElementById('newSearchBtn').style.display = 'none';
      document.getElementById('backListBtn').style.display = 'none';
      // Reset button state fully
      document.getElementById('loadingSpinner').style.display = 'none';
      searchBtn.classList.remove('loading'); // Ensure loading class is removed
      searchBtn.disabled = false;
      // Reset margin
      document.getElementById('leaveCodeContainer').style.marginTop = ''; 
      document.getElementById('idNumberContainer').style.marginTop = ''; 
    }

    function newSearch() {
      resetForm();
    }

    window.addEventListener('load', () => {
      document.getElementById('header').classList.add('show');
      initializeData();
      resetForm(); // Ensure initial state is correct
    });
  </script>
